# Telegram
TELEGRAM_GROUP_ID=
MASTER_USER_ID=

TELEGRAM_TOKEN_LEAD=
TELEGRAM_TOKEN_PM=
TELEGRAM_TOKEN_ARCHITECT=
TELEGRAM_TOKEN_ENGINEER=
TELEGRAM_TOKEN_QA=

TELEGRAM_USERNAME_LEAD=lead_bot
TELEGRAM_USERNAME_PM=pm_bot
TELEGRAM_USERNAME_ARCHITECT=architect_bot
TELEGRAM_USERNAME_ENGINEER=engineer_bot
TELEGRAM_USERNAME_QA=qa_bot

# Owner name shown in prompts.
OWNER_DISPLAY_NAME=Owner

# Router / plain chat providers. OpenAI-compatible /chat/completions endpoints.
ROUTER_PROVIDER=api2
API1_BASE_URL=
API1_KEY=
API1_MODEL=
API1_TYPE=openai
API2_BASE_URL=
API2_KEY=
API2_MODEL=
API2_TYPE=openai

# OpenClaw CLI inside WSL.
OPENCLAW_WSL_DISTRO=OpenClawGateway
OPENCLAW_BIN=/home/openclaw/.openclaw/bin/openclaw
OPENCLAW_TIMEOUT_SECONDS=180

# MCP helper runtime.
PYTHON_BIN=python
OPENCLAW_FILE_ROOTS=C:\;D:\
OPENCLAW_FILE_MAX_READ=200000
